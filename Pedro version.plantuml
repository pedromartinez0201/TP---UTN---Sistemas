@startuml Diagrama
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 40

title Diagrama de Clases Optimizado - Diseño de Sistemas 2026 (Etapa 2)

' =========================================================================
' 1. CAPA SUPERIOR: GESTORES DE LÓGICA (CONTROLADORES)
' =========================================================================
package "Gestores de Logica" #FFF9C4 {
    class ServiciodeAutenticacion <<gestor>> {
        + validarCandidato(tipo: String, nroDni: String, clave: Integer)
        +autenticarUsuario (usuario: String, clave: String)
    }
    class GestorCandidato <<gestor>> {
        + importarCandidatos()
        + exportarResultados()
    }
    class GestorPuesto <<gestor>> {
        + darAltaPuesto()
        + darBajaPuesto()
        + modificarPuesto()
    }
    class GestorCompetencia <<gestor>> {
        + darAltaCompetencia()
        + darBajaCompetencia()
        + modificarCompetencia()
    }
    class GestorFactor <<gestor>> {
        + darAltaFactor()
        + darBajaFactor()
        + modificarFactor()
    }
    class GestorPregunta <<gestor>> {
        + darAltaPregunta()
        + darBajaPregunta()
        + modificarPregunta()
        + generarPreguntaIA()
        + darAltaOpcion()
        + darBajaOpcion()
        + modificarOpcion()
        +generarPreguntaIA(competenciaId: Long, factorId: Long) 
    }
    class GestorEvaluaciones <<gestor>> {
        + evaluarCandidato()
        + completarCuestionario()
        + finalizarCuestionariosPendientes()
        +generarReporteComparativo()
        +generarReporteMerito()
    }
}



' =========================================================================
' 2. CAPA DE NEGOCIO PRINCIPAL: PUESTOS Y COMPETENCIAS
' =========================================================================
package "Gestion de Competencias" #E8F5E9 {
    class Empresa {
        - nombre: String
    }
    class Puesto {
        - id: Long
        - nombre: String
        - descripcion: String
    }
    class CompetenciaRequerida {
        - puntajeMinimo: Double
    }
    abstract class Competencia <<abstract>> {
        - id: Long
        - nombre: String
        - descripcion: String
        + getTipo(): String
    }
    class CompetenciaActitudinal {
        - comportamiento: String
    }
    class CompetenciaTecnica {
        - tecnologia: String
    }
    class Factor {
        - id: Long
        - nombre: String
        - descripcion: String
    }

    ' Jerarquía interna del paquete
    Puesto "1..*" -up-> "1" Empresa : en >
    Puesto "1" *-- "1..*" CompetenciaRequerida : define >
    CompetenciaRequerida "1..*" -right-> "1" Competencia : refiere a >
    Competencia <|-- CompetenciaActitudinal
    Competencia <|-- CompetenciaTecnica
    Competencia "1" *-- "2..*" Factor : se compone de >
}

' =========================================================================
' 3. CAPA DE CONTENIDO: PREGUNTAS Y OPCIONES
' =========================================================================
package "Gestion de Preguntas" #E3F2FD {
    class Pregunta {
        - id: Long
        - enunciado: String
        - tipo: TipoPregunta
        + crearConGenAI(): void
    }
    class OpcionRespuesta {
        - id: Long
        - texto: String
        - puntaje: Double
        - orden: Integer
    }
    enum TipoPregunta {
        OPCION_MULTIPLE
        VERDADERO_FALSO
        ESCALA
    }

    ' Relaciones internas del paquete
    Pregunta "1" *-- "2..*" OpcionRespuesta : tiene >
    Pregunta -right-> TipoPregunta
}

' Relación entre Competencias y Preguntas sin cruzar líneas fijas
Factor "1" *-- "0..*" Pregunta : contiene >

' =========================================================================
' CAPA DE AUTENTICACION DE USUARIOS
' =========================================================================

package "Autenticacion de Usuarios" #FFEBEE{
    abstract class Usuario {
        -apellido: String
        -nombre: String
        -email: String
    }

    class Candidato {
        -nroCandidato: Long
        -tipoDocumento: String
        -nroDocumento: String
        -fechaNacimiento: Date
        -genero: Char
        -nacionalidad: String
        -escolaridad: String
        -clave: String
        -eliminado: Boolean
    }

    class Consultor {
        -nombreUsuario: String
    }

    Usuario <|-- Candidato
    Usuario <|-- Consultor
}
' =========================================================================
' 4. CAPA DE PROCESO Y CANDIDATOS: EVALUACIONES
' =========================================================================
package "Evaluacion de Candidatos" #FAFAFA {
    
    class Cuestionario {
        - id: Long
        - fechaCreacion: Date
        - estado: EstadoCuestionario
        - cantidadPreguntasPorFactor: Integer
        - cantidadPreguntasPorBloque: Integer
    }
    class BloqueCuestionario {
        - id: Long
        - numero: Integer
        - completado: Boolean
    }
    class RespuestaCandidato {
        - id: Long
        - fechaRespuesta: Date
    }
    class Resultado {
        - id: Long
        - puntajeObtenido: Double
        - puntajeRequerido: Double
        - fechaCalculo: Date
        + generarResporteComparativo(): void
        + generarReporteMerito(): void
    }
    enum EstadoCuestionario {
        PENDIENTE
        EN_CURSO
        COMPLETO
    }

    ' Relaciones internas del paquete
    Cuestionario -right-> EstadoCuestionario
    Cuestionario "1" *-- "1..*" BloqueCuestionario : divide en >
    Cuestionario "1" *-- "1" Resultado : genera >
    BloqueCuestionario "1" *-- "1..*" RespuestaCandidato : contiene >
    Resultado "1" --> "*" Candidato : de >
}


' Vinculación del dominio de evaluaciones con los otros paquetes
Cuestionario "0..*" -up-> "1" Candidato : rinde >
Cuestionario "0..*" -up-> "1" Puesto : asociado a >
RespuestaCandidato "*" -up-> "1" Pregunta : evalúa >

' =========================================================================
' DEPENDENCIAS DE USO: DE GESTORES A ENTIDADES (Líneas limpias hacia abajo)
' =========================================================================
ServiciodeAutenticacion ..> Candidato
GestorCandidato ..> Candidato
GestorPuesto ..> Puesto
GestorCompetencia ..> Competencia
GestorFactor ..> Factor
GestorPregunta ..> Pregunta
GestorPregunta ..> OpcionRespuesta
GestorEvaluaciones ..> Cuestionario

' =========================================================================
' DEPENDENCIAS DE USO: DE GESTORES A INTERFACES
' =========================================================================

interface IServicioIA{
    +generarPreguntaConIA(competencia: String , factor: String): String

}



@enduml