@startuml Diagrama

class Cuestionario {
  -id: Long 
  -fechaCreacion: Date
  -estado: EstadoCuestionario
  -cantidadPreguntasPorFactor: Integer 
  -cantidadPreguntasPorBloque: Integer
}

enum EstadoCuestionario{
  PENDIENTE
  EN_CURSO
  COMPLETADO
}

class Pregunta {
    -id: Long
    -enunciado: String
    -tipo: TipoPregunta
    +crearConGenAI(): void
}

enum TipoPregunta{
    OPCION_MULTIPLE
    VERDADERO_FALSO
    ESCALA
}

class OpcionRespuesta{
    -id: Long
    -texto: String
    -puntaje: Double
    -orden: Integer
}

abstract class Competencia {
    -id: Long
    -nombre: String 
    -descripcion: String
    +getTipo() : String
}

class CompetenciaActitudinal {
    -comportamiento: String
}
class Factor{
    -id: Long 
    -nombre: String
    -descripcion: String
}
class CompetenciaTecnica{
    -tecnologia: String
}

Competencia <|-- CompetenciaActitudinal
Competencia <|-- CompetenciaTecnica

class Puesto{
  -id: Long
  -nombre: String
  -descripcion: String
}

class CompetenciaRequerida{
  -puntajeMinimo: Double
}

Puesto "1" *-- "1..*" CompetenciaRequerida : define >
CompetenciaRequerida "1..*" --> "1" Competencia : refiere a >

Competencia "1" *-- "2..*" Factor : se compone de >
Pregunta "1" *-- "2..*" OpcionRespuesta : tiene >
Pregunta ..> TipoPregunta
Pregunta "1" --> "1" Competencia : pertenece >

class Empresa{
  -nombre: String
}

Puesto "1..*" --> "1" Empresa : en >

abstract class Usuario {
  -apellido: String
  -nombre: String
  -email: String
}

class Candidato {
  -nroCandidato: Long
  -tipoDocumento: String
  -nroDocumento: String
  -fechaNacimiento: Date
  -genero: Char
  -nacionalidad: String
  -escolaridad: String
  -clave: String
  -eliminado: Boolean
}

class Consultor {
  -nombreUsuario: String
}

Usuario <|-- Candidato
Usuario <|-- Consultor

Resultado "1" --> "*" Candidato : de >

class Resultado{
  -id: Long
  -puntajeObtenido: Double
  -puntajeRequerido: Double
  -fechaCalculo: Date
  +generarResporteComparativo(): void 
  +generarReporteMerito(): void 
}

class BloqueCuestionario {
  -id: Long
  -numero: Integer 
  -completado: Boolean
}

class RespuestaCandidato {
  -id: Long
  -fechaRespuesta: Date
}

Cuestionario "1" *-- "1..*" BloqueCuestionario : divide en >

BloqueCuestionario "1" *-- "1..*" RespuestaCandidato : contiene >

RespuestaCandidato "*" --> "1" Pregunta : evalúa >

Cuestionario "1" *-- "1" Resultado : genera >
Cuestionario ..> EstadoCuestionario 

package "Gestores de Logica" {
    class ServiciodeAutenticacion <<gestor>> {
        +autenticarUsuario (usuario: String, clave: String)
        +validarCandidato(tipo:String, nroDni:String, clave:Integer)
    }
    class GestorCandidato <<gestor>>{
        +importarCandidatos()
        +exportarResultados()
    }
    class GestorPuesto <<gestor>> {
        +darAltaPuesto()
        +darBajaPuesto()
        +modificarPuesto()
    }
    class GestorFactor <<gestor>> {
        +darAltaFactor()
        +darBajaFactor()
        +modificarFactor()
    }
    class GestorPregunta <<gestor>> {
        +darAltaPregunta()
        +darBajaPregunta()
        +modificarPregunta()
        +generarPreguntaIA(competenciaId: Long, factorId: Long)
        +darAltaOpcion()
        +darBajaOpcion()
        +modificarOpcion()
    }
    class GestorCompetencia <<gestor>> {
        +darAltaCompetencia()
        +darBajaCompetencia()
        +modificarCompetencia()
    }
    class GestorEvaluaciones <<gestor>> {
        +evaluarCandidato()
        +completarCuestionario()
        +finalizarCuestionariosPendientes()
        +generarReporteComparativo()
        +generarReporteMerito()
    }
}
