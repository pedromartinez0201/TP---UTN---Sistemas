@startuml
title Diagrama de Clases - TP Etapa 2 (Primera Versión)

' Configuración estética opcional para VS Code / PlantText
skinparam handwritten false
skinparam classAttributeIconSize 0
skinparam packageStyle frame

package "Módulo 1: Gestión de Competencias y Perfiles" {
    abstract class Competencia {
        - id: Long
        - nombre: String
        - descripcion: String
        + getTipo(): String
    }

    class CompetenciaActitudinal {
        - comportamientoAsociado: String
    }

    class CompetenciaTecnica {
        - tecnologiaRequerida: String
    }

    class Factor {
        - id: Long
        - nombre: String
        - descripcion: String
    }

    class Perfil {
        - id: Long
        - nombrePuesto: String
        - descripcionPuesto: String
    }

    class CompetenciaRequerida {
        - puntajeMinimoExigido: Double
    }
}

package "Módulo 2: Gestión de Preguntas (Banco de Datos)" {
    class Pregunta {
        - id: Long
        - enunciado: String
        + crearConGenAI(): void
    }

    class OpcionRespuesta {
        - id: Long
        - textoOpcion: String
        - puntajeAsignado: Double
        - ordenVisual: Integer
    }

    enum TipoPregunta {
        OPCION_MULTIPLE
        VERDADER_FALSO
        ESCALA_LIKERT
    }
}

package "Módulo 3: Evaluación de Candidatos" {
    class Cuestionario {
        - id: Long
        - fechaCreacion: Date
        - cantidadPreguntasPorFactor: Integer
        + iniciarCuestionario(): void
    }

    class BloqueCuestionario {
        - id: Long
        - numeroPagina: Integer
        - estaCompletado: Boolean
    }

    class RespuestaCandidato {
        - id: Long
        - fechaHoraRespuesta: DateTime
    }

    class Resultado {
        - id: Long
        - puntajeObtenido: Double
        - puntajeRequerido: Double
        - esApto: Boolean
        + generarReporteComparativo(): void
        + generarReporteMerito(): void
    }

    enum EstadoCuestionario {
        PENDIENTE
        EN_CURSO
        COMPLETADO
    }
}

' ==========================================
' RELACIONES Y MULTIPLICIDADES
' ==========================================

' Herencia de Competencias
Competencia <|-- CompetenciaActitudinal
Competencia <|-- CompetenciaTecnica

' Una Competencia se compone obligatoriamente de al menos 2 Factores
Competencia "1" *-- "2..*" Factor : compuesto por >

' Relación entre Perfil y las Competencias que requiere
Perfil "1" *-- "1..*" CompetenciaRequerida : exige >
CompetenciaRequerida "1..*" --> "1" Competencia : evalúa a >

' Relación de Preguntas con sus Factores y Opciones
Pregunta "1..*" --> "1" Factor : pertenece a >
Pregunta "1" *-- "2..*" OpcionRespuesta : contiene >
Pregunta ..> TipoPregunta : usa >

' El motor dinámico del Cuestionario
Cuestionario "1" *-- "1..*" BloqueCuestionario : se divide en >
Cuestionario ..> EstadoCuestionario : estado es >
Cuestionario "1" -- "1" Resultado : calcula >

' Registro de respuestas del candidato
BloqueCuestionario "1" *-- "0..*" RespuestaCandidato : almacena >
RespuestaCandidato "1..*" --> "1" Pregunta : responde a >
RespuestaCandidato "1" --> "1" OpcionRespuesta : seleccionó >

note bottom of Resultado
  Clase encargada de ejecutar las fórmulas
  de ponderación requeridas por la cátedra.
end note

@enduml