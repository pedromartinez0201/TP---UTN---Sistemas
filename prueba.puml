@startuml Diagrama

class Cuestionario {
  -id: Long 
  -fechaCreacion: Date
  -estado: EstadoCuestionario
  -cantidadPreguntasPorFactor: Integer 
  -cantidadPreguntasPorBloque: Integer
}

enum EstadoCuestionario{
  PENDIENTE
  EN_CURSO
  COMPLETADO
}
title TP

caption Modulo Gestion de Competencias y Gestion de Preguntas
class Pregunta {
    -id: Long
    -enunciado: String
    -tipo: TipoPregunta
    +crearConGenAI(): void
}

enum TipoPregunta{
    OPCION_MULTIPLE
    VERDADERO_FALSO
    ESCALA
}

class OpcionRespuesta{
    -id: Long
    -texto: String
    -puntaje: Double
    -orden: Integer
}

abstract class Competencia {
    -id: Long
    -nombre: String 
    -descripcion: String
    +getTipo() : String
}

class CompetenciaActitudinal {
    -comportamiento: String
}
class Factor{
    -id: Long 
    -nombre: String
    -descripcion: String
}
class CompetenciaTecnica{
    -tecnologia: String
}

Competencia <|-- CompetenciaActitudinal
Competencia <|-- CompetenciaTecnica

class Resultado{
  -id: Long
  -puntajeObtenido: Double
  -puntajeRequerido: Double
  -fechaCalculo: Date
  +generarResporteComparativo(): void 
  +generarReporteMerito(): void 
}

class BloqueCuestionario {
  -id: Long
  -numero: Integer 
  -completado: Boolean
}

class RespuestaCandidato {
  -id: Long
  -fechaRespuesta: Date
}

Cuestionario "1" *-- "1..*" BloqueCuestionario : divide en >

'Cuestionario "*" --> "1" Candidato : rendido por >
'Cuestionario "*" --> "1" Puesto : asociado a >

BloqueCuestionario "1" *-- "1..*" RespuestaCandidato : contiene >

RespuestaCandidato "*" --> "1" Pregunta : evalúa >
RespuestaCandidato "*" --> "1" OpcionRespuesta : selecciona >

Cuestionario "1" *-- "1" Resultado : genera >
Cuestionario ..> EstadoCuestionario 

@enduml